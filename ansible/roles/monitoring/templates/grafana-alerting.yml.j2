apiVersion: 1

contactPoints:
  - orgId: 1
    name: Telegram
    receivers:
      - uid: telegram-homepulse
        type: telegram
        settings:
          bottoken: "{{ telegram_bot_token }}"
          chatid: "{{ telegram_chat_id }}"
          message: |
            🏠 HomePulse Alert
            {{ "{{ .CommonLabels }}" }}
            {{ "{{ .CommonAnnotations.description }}" }}

policies:
  - orgId: 1
    receiver: Telegram
    group_by: ['grafana_folder', 'alertname']
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 1h
